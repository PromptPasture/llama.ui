{
	"private": true,
	"name": "llama.ui",
	"description": "A minimal Interface for AI Companion that runs entirely in your browser.",
	"version": "2.38.2",
	"homepage": "https://llama-ui.js.org/",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"start": "vite dev",
		"build": "vite build",
		"build:prod": "vite build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "eslint . && prettier --write .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"preview": "npm run build && vite preview"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"bits-ui": "^2.18.1",
		"dexie": "^4.4.4",
		"katex": "^0.17.0",
		"lucide-svelte": "^1.0.1",
		"marked": "^18.0.5",
		"marked-katex-extension": "^5.1.10",
		"svelte-i18n": "^4.0.1",
		"vite-plugin-pwa": "^1.3.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-package-version": "^1.1.0"
	},
	"prettier": {
		"trailingComma": "es5",
		"tabWidth": 2,
		"semi": true,
		"singleQuote": true,
		"bracketSameLine": false
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/olegshulyakov/llama.ui.git"
	}
}
